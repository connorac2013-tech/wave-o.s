ESPNEW
function setup {
ESpindesk
clear white
txt 0 0 4 "initializing" black
loop 56 {
draw square x 240 10 black
add x 9
pause 0
}
set x 0
loop 24 {
draw square x 240 10 green
add x 20
pause 100
}
clear black
add initOK 1
}
function loop {
if osver < 1100 then txt 0 0 3 "device must be updated" red

if osver > 1100 then txt 0 0 3 "device is updated" green
if osver > 1100 {
box test 150 150 50 50 green
if test > 0 {
clear green
pause 1000
}
}
note{
version: 0.12
