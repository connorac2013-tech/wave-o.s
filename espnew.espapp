ESPNEW
function setup {

clear white
txt 0 0 4 "initializing" black
loop 56 {
draw square x 230 10 black
add x 9
pause 0
}
loop 24 {
draw square x 230 10 green
add x 20
pause 100
}
clear black
add initOK 1
}
function loop {
if osver > 11.98 then txt 0 0 1 "device must be updated" red


if osver < 11.98 then txt 0 0 1 "device is updated" green

note{
version: 0.12
author: wave o.s developer
