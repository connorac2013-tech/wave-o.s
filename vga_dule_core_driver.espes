V = ESver
if V >= 9.02 then
else
msgbox"This script is for WAVE O.S version 9.02 or greater.",vbexclamation,"Compatibility warning"
msgbox"this may not work correctly.",vbexclamation,"Compatibility warning (Con)"
end if
ESpindesk"VGA_PRO"
ESstartfiletask
ESstartupdateutillity
ESwritebintopath"NVSD","0x003, 0x001"
A = msgbox ("your device must restart to finish some updates or driver installs, do you wish to restart now",vbquestion + vbyesno,"wave o.s")
if A = vbyes then
ESrestart
else
endif
