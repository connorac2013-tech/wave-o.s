V = ESver
if V >= 8.38 then
ESpindesk
else
msgbox"This script is for WAVE O.S version 9.02 or greater.",vbexclamation,"Compatibility warning"
msgbox"This may not work correctly.",vbexclamation,"Compatibility warning (Con)"
end if
msgbox"your device must restart to finish some updates or",vbinformation,"Wave O.S"
A = msgbox(" driver installs. Do you wish to restart now?",vbquestion + vbyesnocancel, "Wave O.S (con)")
if A = vbyes then
ESrestart
else
msgbox"Legacy note: if this is the only message you saw,",vbinformation,"VGA PRO"
msgbox"you are likely not eligible for this program.",vbinformation,"VGA PRO (CON)"
end if
